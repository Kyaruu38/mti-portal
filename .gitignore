# Dependencies (this project has no build step and currently ships with none
# committed — `npm run start`/`dev` run `serve` via npx, no local install —
# but ignored defensively in case that ever changes).
node_modules/

# Environment / secrets — none exist in this repo today (verified before
# writing this file), ignored defensively so one never gets committed by accident.
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json
*credentials*.json
*secret*.json

# OS / editor cruft
.DS_Store
Thumbs.db

# Internal tooling - not for public web
supabase_*.sql
supabase_schema.sql
CLAUDE.md
SETUP.md

# Supabase CLI local link/session metadata (project ref, pooler URL, etc.)
supabase/.temp/

# Windows Explorer folder metadata — never useful in a repo
desktop.ini

# Agent/editor workspace metadata
.claude/
