# Dependencies (this project has no build step and currently ships with none
# committed — `npm run start`/`dev` run `serve` via npx, no local install —
# but ignored defensively in case that ever changes).
node_modules/

# Environment / secrets — none exist in this repo today (verified before
# writing this file), ignored defensively so one never gets committed by accident.
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json
*credentials*.json
*secret*.json

# OS / editor cruft
.DS_Store
Thumbs.db

# Internal tooling - not for public web
supabase_*.sql
supabase_schema.sql
CLAUDE.md
SETUP.md

# Supabase CLI local link/session metadata (project ref, pooler URL, etc.)
supabase/.temp/

# Windows Explorer folder metadata — never useful in a repo
desktop.ini

# Agent/editor workspace metadata
.claude/

# Sisa transfer file dari sesi agent — bukan bagian portal.
_to_delete/
*.tgz

# ============================================================================
# DOKUMEN KERJA — JANGAN PERNAH MASUK REPO PUBLIK
# ----------------------------------------------------------------------------
# Repo ini publik (harus, supaya GitHub Pages jalan di akun free). Artinya
# setiap file di sini bisa dibaca siapa pun tanpa login.
#
# Yang di bawah ini bukan bagian dari portal. Dicek sebelum ditulis: samples/
# cuma disebut di KOMENTAR, tidak ada satu pun fetch/import yang menyentuhnya,
# dan logo + cap sudah ditanam sebagai base64 di src/assets/images.js. Jadi
# menghapusnya dari repo tidak mematikan apa pun.
#
# Isinya: rencana produksi PPIC, PO asli lengkap dengan nama supplier dan
# nilai kontrak, PRF, surat jalan, berkas PPKEK, master supplier.
#
# vendor/ SENGAJA TIDAK diikutkan — libarchive.wasm dimuat saat runtime oleh
# src/parsers/archive.js. Menghapusnya mematikan pembacaan file PPKEK.
# ============================================================================

samples/
*.xlsx
*.xls
*.pdf
*.rar
*.zip

# HANDOVER*.md tanpa tanda hubung — polanya dulu "HANDOVER-*.md", yang TIDAK
# cocok dengan HANDOVER.md. Ketahuan waktu git status menampilkannya sebagai
# untracked sesudah handover berhenti memakai tanggal di namanya. Repo ini
# publik dan berkas itu memuat nama pemasok, nomor pendaftaran pabean, dan nilai
# pembelian.
HANDOVER*.md

# Laporan audit — dan ini yang PALING tidak boleh masuk repo publik dari seluruh
# daftar ini. Isinya bukan sekadar nama pemasok dan nilai pembelian, tapi peta
# lengkap di mana lubangnya berada dan bagaimana mencapainya.
#
# Ketahuan dari `git status --short` yang menampilkannya sebagai untracked —
# persis cara HANDOVER.md ketahuan sehari sebelumnya. Dua kali dari sebab yang
# sama: berkas kerja baru dibuat di root dengan nama yang tidak cocok pola mana
# pun. Sebelum menambah berkas kerja apa pun ke root, tambahkan polanya di sini
# LEBIH DULU — bukan sesudah git status mengingatkan.
AUDIT*.md

# Handoff antar-sesi Cowork. Sama bahayanya dengan AUDIT*.md: memuat daftar
# lubang yang MASIH TERBUKA (per 12 Agustus: drive-upload belum ditambal),
# nama akun, id proyek Supabase, dan jalur disk. Polanya ditambahkan SEBELUM
# berkasnya dibuat — kali ini urutannya benar.
COWORK-HANDOFF*.md
HANDOFF*.md

PANDUAN*.md
PPKEK-ANALISA.md
PESAN-COMMIT-*.txt

# Cadangan .gitignore dari sesi agent.
.gitignore.bak

# Harness Node dari sesi agent — dijalankan di luar browser buat menguji logika
# murni (parser PPKEK, aturan pilih-semua, aturan harga label). Bukan bagian
# portal: tidak ada satu pun berkas di src/ yang mengimpornya dan index.html
# tidak menyebutnya.
#
# Ditulis SEBELUM git status sempat mengingatkan. Dua kali sebelumnya —
# HANDOVER.md lalu AUDIT-8-Agustus.md — polanya baru ditambahkan SESUDAH
# berkasnya muncul sebagai untracked di repo publik. Dan yang ini bukan sekadar
# kode: harness harga label memuat nama pemasok dan kode ERP ASLI, karena aturan
# 7 menuntut pengujian lawan angka dokumen sungguhan, bukan angka karangan.
test-*.mjs
# data uji harness — bukan kode, tapi isinya nama spec dan angka stok
# pemasok yang sungguhan. Polanya ditambahkan SEBELUM berkasnya sempat
# muncul sebagai untracked, bukan sesudah git status mengingatkan.
test-*.json
test.mjs
verify.mjs
run.mjs
Claude outputs/
*.patch
uji-*
# ...KECUALI penyaring artwork dasar. `uji-*` dibuat untuk berkas banding
# urgensi yang memang sekali pakai, dan ia menyerap alat/dasar/uji-dasar.mjs
# tanpa suara — padahal itulah yang MEMBUAT src/label/dasarPeta.js, dan
# satu-satunya cara membuatnya ulang kalau artworknya berubah. Peta tanpa
# alat pembuatnya adalah angka yang tidak bisa diperiksa siapa pun lagi.
!alat/dasar/uji-dasar.mjs

# Aset merek hasil panen (alat/panen-aset.mjs). Potongan artwork SUNGGUHAN
# milik merek — logo WESTLAKE, GOODRIDE dan seterusnya — dipotong dari berkas
# yang dibuat vendor. Repo ini PUBLIK.
#
# Polanya ditambahkan SEBELUM berkasnya sempat muncul sebagai untracked,
# bukan sesudah git status mengingatkan — pelajaran yang sudah dibayar dua
# kali di berkas ini (HANDOVER.md, lalu AUDIT-8-Agustus.md).
#
# ALATNYA tetap ikut repo; yang tidak ikut cuma hasil panennya. Siapa pun
# yang punya artworknya bisa membuat ulang isinya dalam hitungan detik, dan
# itu jauh lebih murah daripada menerbitkan aset merek orang lain.
alat/aset/

# Cache bytecode Python dari alat/. Bukan kode, dibuat ulang sendiri tiap
# alatnya jalan, dan memuat jalur absolut mesin yang membuatnya.
__pycache__/
*.pyc

# Artwork asli hasil panen dari Drive untuk penyaringan artwork dasar.
# ALASANNYA SAMA DENGAN alat/aset/ DI ATAS, DAN LEBIH KERAS: ini 62 MB artwork
# MEREK ORANG LAIN — Capitol, Arroyo, Hercules, Travelstar dan 50-an lainnya —
# dan repo ini PUBLIK. Yang boleh ikut repo cuma hasil UKURANnya, dan itu sudah
# ada di src/label/dasarPeta.js: id Drive plus angka, tanpa satu byte artwork.
# Berkasnya sendiri tetap di Drive, di belakang izin Drive dan di belakang
# drive-download yang menolak id yang tidak terdaftar sebagai artwork.
alat/dasar/unduh/
alat/dasar/putusan.json
alat/dasar/peta-mentah.json
alat/dasar/peta-resmi.json
